# Configuración de BOTikor: ejemplo comentado.
#
# Lo normal es NO escribir este fichero a mano: la primera vez que lanzas
# botikor.sh desde una terminal te hace las preguntas y crea botikor.conf
# él solo. Si prefieres hacerlo a mano, copia este fichero como
# /home/root/botikor/botikor.conf, rellénalo y protégelo:
#     chmod 600 /home/root/botikor/botikor.conf
#
# Formato: una línea CLAVE=valor por variable, SIN comillas y sin espacios
# alrededor del "=". El valor llega tal cual hasta el final de la línea, así
# que una contraseña puede llevar $ " ` \ o espacios. Las líneas que empiezan
# por # son comentarios. Este fichero lleva el token del bot: no lo compartas.

# Token del bot. Te lo da @BotFather al crearlo (/newbot). Obligatorio.
TOKEN=

# Número del único chat al que obedece el bot (el tuyo). Obligatorio.
# Te lo da @userinfobot, o la configuración inicial al escribirle al bot.
ID=

# Dirección de OpenWebIF (la web del deco). En el propio deco es esta.
WEBIF=http://127.0.0.1

# Solo si OpenWebIF pide usuario y contraseña; si no, déjalos vacíos.
WEBIF_USUARIO=
WEBIF_CLAVE=

# Fichero donde está (o se guarda) la lista de canales.
GHOSTLIST=/home/root/botikor/lista.m3u8

# Dirección "m3u URL" de la lista en la web de ghostreamy (menú Listas). Con
# ella el bot descarga la lista él solo al enviarle /actualizar_canales. Da
# igual qué IP traiga: el bot la pide siempre a 127.0.0.1. Lleva tu código de
# ghostreamy: no la compartas. Vacía: copias tú el fichero lista.m3u8 al deco.
GHOSTLIST_URL=

# Puerto donde escucha ghostreamy dentro del deco. Con "auto" se saca de las
# URLs de la lista (si no se puede, 3138).
GHOST_PORT_INT=auto

# Puerto que tu router abre hacia Internet y lleva al de ghostreamy. Solo lo
# usa /canal X para darte la URL de fuera de casa. Vacío: el mismo que el interno.
GHOST_PORT_EXT=

# Puerto de streaming propio de Enigma2. Casi nunca hay que cambiarlo.
STREAMPORT_NATIVO=8001

# Carpeta donde graba el deco. El bot avisa por Telegram de cada grabación
# nueva que aparece en ella.
GRABACIONES=/hdd/movie

# Log de OSCam. /estado lo lee para decirte si se está descifrando bien
# (servidor de claves caído, lector que no conecta...). Vacío: no se mira.
OSCAM_LOG=/tmp/oscam.log
